            VALUE "InternalName", "LangSwitch\0"
            VALUE "OriginalFilename", "LangSwitch.exe\0"
            VALUE "ProductName", "LangSwitcher\0"
            VALUE "ProductVersion", "1.2.0\0"
        END
    END

    BLOCK "VarFileInfo"
